# Environment / secrets — never commit
.env
.env.*
!.env.example
config.local.php

# Composer
/vendor/

# Logs
/logs/
*.log

# Database dumps — NEVER commit; they may contain customer PII
# Re-allow schema-only migration files which are safe and intentional
*.sql
!database/migrations/*.sql

# Debug / seed files — delete these before going live
test_secret.php
create_admin.php
seed.php
user/debug_payment.php
user/test_paymongo.php
admin/walkin_payment_debug.php

# Editor noise
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# User-uploaded images — these live on the server's persistent filesystem
# (symlinked from uploads/services and uploads/products to a folder outside
# public_html, so deploys can never touch them), not in git. Committing them
# caused the opposite problem: images uploaded live through the admin panel
# were never in git, and a deploy appeared to reset the folder back to
# whatever WAS committed, silently erasing them.
/uploads/services/
/uploads/products/
