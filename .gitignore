# Environment / secrets — never commit
.env
.env.*
!.env.example
config.local.php

# User-uploaded content — lives only on the live server (symlinked on
# production to ~/persistent_uploads/, outside the deploy path, so a deploy
# never wipes a photo staff uploaded directly). Never committed: these
# change constantly and a fresh checkout doesn't need the current catalog's
# images to run.
/uploads/services/*
/uploads/products/*
!/uploads/services/.gitkeep
!/uploads/products/.gitkeep

# Composer
/vendor/

# Logs
/logs/
*.log

# Database dumps — NEVER commit; they may contain customer PII
# Re-allow schema-only migration files which are safe and intentional
*.sql
!database/migrations/*.sql

# Debug / seed files — delete these before going live
test_secret.php
create_admin.php
seed.php
user/debug_payment.php
user/test_paymongo.php
admin/walkin_payment_debug.php

# Editor noise
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

vendor.zip
