<?php
/**
 * config.local.php  —  Host-specific database credentials (NEVER commit this file)
 *
 * Copy this file to config.local.php and fill in real values.
 * config.local.php is listed in .gitignore and must NEVER be committed.
 *
 * When this file exists, config.php uses it instead of reading from .env
 * via getenv(). Use it on hosts where getenv() cannot be set for custom
 * variables (e.g. Hostinger shared PHP hosting).
 *
 * On local XAMPP / environments that support .env: do NOT create this file —
 * config.php will fall back to .env automatically.
 *
 * Upload to the server root (same directory as config.php) via FTP or
 * the hosting control panel's File Manager.
 */

$_db_server = 'localhost';
$_db_user   = 'your_db_username';
$_db_pass   = 'your_db_password';
$_db_name   = 'your_db_name';
